<Window x:Class="SYSMR.UI.FirebaseConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuração Firebase" Width="540" Height="510" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Conectar ao Firebase" FontSize="23" FontWeight="Bold" Foreground="#17233B"/>
        <TextBlock Grid.Row="1" Text="Requer Firebase Authentication com provedor E-mail/Senha ativado e Realtime Database." TextWrapping="Wrap" Foreground="#748198" Margin="0,8,0,15"/>
        <StackPanel Grid.Row="2">
            <TextBlock Text="Project ID" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="ProjectIdBox" Padding="8"/>
            <TextBlock Text="Web API Key (chave pública do app Firebase)" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <TextBox x:Name="ApiKeyBox" Padding="8"/>
            <TextBlock Text="Realtime Database URL (HTTPS)" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <TextBox x:Name="DatabaseUrlBox" Padding="8"/>
            <TextBlock Text="URL HTTPS da Cloud Function de provisionamento" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <TextBox x:Name="ProvisioningUrlBox" Padding="8"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#B54708" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <TextBlock Grid.Row="4" Text="Não informe service-account JSON, senha administrativa do Firebase ou tokens. A Web API Key não substitui regras de segurança." TextWrapping="Wrap" Foreground="#748198" FontSize="11" Margin="0,8,0,0"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Margin="0,0,8,0" Padding="14,7" Click="Cancel_Click"/>
            <Button Content="Salvar parâmetros" Padding="14,7" Background="#17233B" Foreground="White" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
