<Window x:Class="SYSMR.UI.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SYSMR" Width="420" Height="250" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Background="White" CornerRadius="18" BorderBrush="#E3E9F1" BorderThickness="1" Padding="30">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.18" Color="#17233B"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="SYSMR" FontSize="32" FontWeight="Bold" Foreground="#17233B"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Gestão e ponto de venda" FontSize="13" Foreground="#68778F"
                       HorizontalAlignment="Center" Margin="0,3,0,20"/>
            <ProgressBar IsIndeterminate="True" Height="5" Foreground="#18A999"
                         Background="#E6ECF3" BorderThickness="0"/>
            <TextBlock x:Name="StatusText" Text="Iniciando..." FontSize="12" Foreground="#68778F"
                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
        </StackPanel>
    </Border>
</Window>
