<Window x:Class="SYSMR.UI.StoreContactEmailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E-mail de contato da loja" Width="520" Height="560" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="E-mail de contato da loja" FontSize="23" FontWeight="Bold" Foreground="#17233B"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#748198" Margin="0,8,0,15"
                   Text="O e-mail de contato recebe o link de redefinição de senha e passa a ser o identificador de login da loja. Deixe em branco para remover e voltar ao acesso interno."/>
        <StackPanel Grid.Row="2">
            <TextBlock Text="Número da loja" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="CustomerNumberBox" Padding="8"/>
            <TextBlock Text="E-mail de contato (vazio para remover)" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <TextBox x:Name="ContactEmailBox" Padding="8"/>
            <TextBlock Text="E-mail Firebase do Super Admin global" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <TextBox x:Name="SuperAdminEmailBox" Padding="8"/>
            <TextBlock Text="Senha Firebase do Super Admin (usada somente nesta solicitação)" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <PasswordBox x:Name="SuperAdminPasswordBox" Padding="8"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#B54708" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Margin="0,0,8,0" Padding="14,7" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Content="Salvar e-mail" Padding="14,7" Background="#17233B" Foreground="White" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
