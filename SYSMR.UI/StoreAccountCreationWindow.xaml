<Window x:Class="SYSMR.UI.StoreAccountCreationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Criar conta da loja" Width="540" Height="690" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Cadastrar acesso da loja" FontSize="23" FontWeight="Bold" Foreground="#17233B"/>
        <TextBlock Grid.Row="1" Text="A conta será criada no Firebase e uma cópia segura será salva neste computador." TextWrapping="Wrap" Foreground="#748198" Margin="0,8,0,15"/>
        <StackPanel Grid.Row="2">
            <TextBlock Text="Número da loja" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="CustomerNumberBox" Padding="8"/>
            <TextBlock Text="Nome da loja" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <TextBox x:Name="CustomerNameBox" Padding="8"/>
            <TextBlock Text="Tipo de operação" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <ComboBox x:Name="StoreTypeCombo" Padding="8" SelectedIndex="0">
                <ComboBoxItem Content="Vendas / PDV" Tag="sales"/>
                <ComboBoxItem Content="Restaurante" Tag="restaurant"/>
            </ComboBox>
            <TextBlock Text="Senha (8 a 128 caracteres)" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <PasswordBox x:Name="PasswordBox" Padding="8"/>
            <TextBlock Text="Confirmar senha" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Padding="8"/>
            <TextBlock Text="E-mail Firebase do Super Admin global" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <TextBox x:Name="SuperAdminEmailBox" Padding="8"/>
            <TextBlock Text="Senha Firebase do Super Admin (usada somente nesta solicitação)" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <PasswordBox x:Name="SuperAdminPasswordBox" Padding="8"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#B54708" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Margin="0,0,8,0" Padding="14,7" Click="Cancel_Click"/>
            <Button x:Name="CreateButton" Content="Criar conta" Padding="14,7" Background="#17233B" Foreground="White" Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>
