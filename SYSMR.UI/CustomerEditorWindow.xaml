<Window x:Class="SYSMR.UI.CustomerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro de cliente" Width="500" Height="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Text="Novo cliente" FontSize="24" FontWeight="Bold" Foreground="#17233B"/>
        <TextBlock Grid.Row="1" Text="O cadastro recebe um prazo de revisão de 30 dias. O vencimento gera alerta, sem bloquear vendas." TextWrapping="Wrap" Foreground="#748198" Margin="0,7,0,16"/>
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Nome completo *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="NameBox"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="CPF / CNPJ" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="DocumentBox"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="Telefone" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="PhoneBox"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Margin="0,0,0,12">
            <TextBlock Text="E-mail" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="EmailBox"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Grid.Row="6" Foreground="#B42318" TextWrapping="Wrap" VerticalAlignment="Top"/>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Voltar" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Salvar cliente" Background="#17233B" Foreground="White" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
