<Window x:Class="SYSMR.UI.RestaurantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/SYSMR.UI;component/Assets/sysmr.ico"
        Title="SYSMR | Restaurante" Height="820" Width="1360" MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#F3F6FA" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="RestaurantNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C8D3E2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="16,13"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#17233B">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top" Margin="4,10,4,32">
                    <TextBlock Text="SYSMR" FontSize="27" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="RESTAURANTE" FontSize="10" FontWeight="SemiBold" Foreground="#8CA0BA" Margin="2,3,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="4,0,4,6">
                    <Border Background="#22324E" CornerRadius="9" Padding="12">
                        <StackPanel>
                            <TextBlock x:Name="SyncHeadline" Text="SINCRONIZAÇÃO" Foreground="#61D6B7" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="SyncDetail" Text="Verificando fila local..." Foreground="#A7B4C7" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="SYSMR • restaurante" Foreground="#74839A" FontSize="10" Margin="3,14,0,0"/>
                </StackPanel>
                <StackPanel>
                    <Button Style="{StaticResource RestaurantNavButton}" Content="▦   Salão e mesas" Click="ShowTables_Click"/>
                    <Button Style="{StaticResource RestaurantNavButton}" Content="☷   Cardápio" Click="ShowMenu_Click"/>
                    <Button Style="{StaticResource RestaurantNavButton}" Content="♙   Funcionários" Click="ShowEmployees_Click"/>
                    <Button Style="{StaticResource RestaurantNavButton}" Content="▣   Caixa" Click="ShowCash_Click"/>
                    <Button Style="{StaticResource RestaurantNavButton}" Content="⚙   Configurações" Click="ShowSettings_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28,22,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageHeading" Text="Salão e mesas" FontSize="19" FontWeight="Bold" Foreground="#17233B"/>
                    <TextBlock x:Name="PageSubtitle" Text="Mesas cinzas estão livres; mesas verdes têm comanda aberta." FontSize="11" Foreground="#748198" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="StoreLabel" Text="Restaurante" Foreground="#52627A" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <Button Content="—" ToolTip="Minimizar" FontSize="17" Width="36" Height="32" Padding="0" Margin="4,0" Click="Minimize_Click"/>
                    <Button x:Name="MaximizeButton" Content="□" ToolTip="Maximizar" Width="36" Height="32" Padding="0" Margin="4,0" Click="Maximize_Click"/>
                    <Button Content="×" ToolTip="Fechar" FontSize="19" Width="36" Height="32" Padding="0" Margin="4,0,0,0" Foreground="#B42318" Click="Close_Click"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid x:Name="TablesPage">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="White" CornerRadius="10" BorderBrush="#E8EDF3" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Área" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="AreaCombo" Width="230" Padding="8" DisplayMemberPath="Name" SelectionChanged="Area_SelectionChanged"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="↻ Atualizar" Padding="10,7" Click="RefreshTables_Click"/>
                            <TextBlock x:Name="AreaStatusText" VerticalAlignment="Center" Foreground="#748198" Margin="20,0,0,0"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E8EDF3" BorderThickness="1" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TablesItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Click="Table_Click" Width="170" Height="126" Margin="8" Padding="12" BorderThickness="1" BorderBrush="#D8DEE8">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#E5E7EB"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                            <Setter Property="Background" Value="#B7E4C7"/>
                                                            <Setter Property="BorderBrush" Value="#238636"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel>
                                                    <Border Width="42" Height="42" CornerRadius="21" Background="#FFFFFF" BorderBrush="#D8DEE8" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Border Width="20" Height="14" CornerRadius="4" Background="#75849A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Ellipse Width="7" Height="7" Fill="#75849A" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                                            <Ellipse Width="7" Height="7" Fill="#75849A" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                                            <Ellipse Width="7" Height="7" Fill="#75849A" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                            <Ellipse Width="7" Height="7" Fill="#75849A" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding Number, StringFormat='Mesa {0}'}" FontSize="19" FontWeight="Bold" Foreground="#17233B" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="#52627A" HorizontalAlignment="Center" Margin="0,7,0,2"/>
                                                <TextBlock Text="{Binding Total, StringFormat=C2}" FontSize="15" FontWeight="SemiBold" Foreground="#17233B" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <Grid x:Name="MenuPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel><TextBlock Text="Cardápio do restaurante" FontSize="22" FontWeight="Bold"/><TextBlock Text="Clique duas vezes em nome, categoria ou preço para editar diretamente na lista." Foreground="#748198" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="＋ Novo item" Background="#17233B" Foreground="White" Margin="0,0,8,0" Padding="12,7" Click="NewMenuItem_Click"/>
                            <Button Content="Editar item" Margin="0,0,8,0" Padding="12,7" Click="EditMenuItem_Click"/>
                            <Button x:Name="ToggleMenuButton" Content="Desativar item" Padding="12,7" Click="ToggleMenuItem_Click"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="MenuGrid" Grid.Row="1" IsReadOnly="False" AutoGenerateColumns="False"
                              CanUserAddRows="False" SelectionChanged="MenuGrid_SelectionChanged"
                              RowEditEnding="MenuGrid_RowEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ITEM" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="CATEGORIA" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                            <DataGridTextColumn Header="PREÇO (R$)" Binding="{Binding Price, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding StatusLabel}" IsReadOnly="True" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <Grid x:Name="EmployeesPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel><TextBlock Text="Funcionários" FontSize="22" FontWeight="Bold"/><TextBlock Text="Cadastro operacional local; login individual e permissões por cargo ainda não fazem parte desta versão." Foreground="#748198" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="＋ Novo funcionário" Background="#17233B" Foreground="White" Margin="0,0,8,0" Padding="12,7" Click="NewEmployee_Click"/>
                            <Button Content="Editar" Margin="0,0,8,0" Padding="12,7" Click="EditEmployee_Click"/>
                            <Button x:Name="ToggleEmployeeButton" Content="Desativar" Padding="12,7" Click="ToggleEmployee_Click"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="EmployeesGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" SelectionChanged="EmployeesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NOME" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="FUNÇÃO" Binding="{Binding Role}" Width="220"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding StatusLabel}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <Grid x:Name="CashPage" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Caixa" FontSize="22" FontWeight="Bold" Foreground="#17233B"/>
                        <TextBlock Text="Abra o caixa no início do turno e informe o valor contado para encerrá-lo." Foreground="#748198" Margin="0,4,0,16"/>
                        <Border Background="White" CornerRadius="12" BorderBrush="#E8EDF3" BorderThickness="1" Padding="22">
                            <StackPanel>
                                <TextBlock x:Name="CashStatusText" Text="Carregando caixa..." FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CashOpeningText" Margin="0,12,0,0"/>
                                <TextBlock x:Name="CashSalesText" Margin="0,6,0,0"/>
                                <TextBlock x:Name="CashExpectedText" Margin="0,6,0,14"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="OpenCashButton" Content="Abrir caixa" Background="#17233B" Foreground="White" Padding="14,9" Click="OpenCash_Click"/>
                                    <Button x:Name="CloseCashButton" Content="Encerrar caixa" Background="#B42318" Foreground="White" Padding="14,9" Margin="10,0,0,0" Click="CloseCash_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Configurações do restaurante" FontSize="22" FontWeight="Bold" Foreground="#17233B" Margin="0,0,0,14"/>
                        <Border Background="White" CornerRadius="12" BorderBrush="#E8EDF3" BorderThickness="1" Padding="22">
                            <StackPanel>
                                <TextBlock Text="Áreas e quantidade de mesas" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="Crie áreas (por exemplo, Salão, Varanda ou Área 1) e configure quantas mesas aparecem em cada uma. Reduzir a quantidade só remove mesas livres." TextWrapping="Wrap" Foreground="#748198" Margin="0,6,0,12"/>
                                <DataGrid x:Name="SettingsAreasGrid" Height="240" IsReadOnly="True" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ÁREA" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="MESAS" Binding="{Binding TableCount}" Width="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="＋ Nova área" Padding="12,8" Background="#17233B" Foreground="White" Click="NewArea_Click"/>
                                    <Button Content="Definir quantidade de mesas" Padding="12,8" Margin="8,0,0,0" Click="SetTableCount_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="AdminToolsPanel" Visibility="Collapsed" Background="White" CornerRadius="12" BorderBrush="#E8EDF3" BorderThickness="1" Padding="22" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Formato da loja" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="Alterne entre Restaurante e Lojista / PDV. O SYSMR será fechado para carregar o novo formato." TextWrapping="Wrap" Foreground="#748198" Margin="0,6,0,10"/>
                                <CheckBox x:Name="RestaurantFormatToggle" Content="Esta loja usa o formato Restaurante" IsChecked="True" Click="RestaurantFormatToggle_Click"/>
                                <TextBlock Text="A troca exige conexão com Firebase e fila de sincronização vazia." Foreground="#B54708" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <Separator Margin="0,18,0,14"/>
                                <TextBlock Text="Modelos de cardápio" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="Escolha um tipo de restaurante. Os itens existentes não serão duplicados; revise os preços sugeridos antes de vender." TextWrapping="Wrap" Foreground="#748198" Margin="0,6,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="MenuTemplateCombo" Width="240" Padding="8" DisplayMemberPath="Name" VerticalContentAlignment="Center"/>
                                    <Button Content="Adicionar modelo" Background="#17233B" Foreground="White" Margin="8,0,0,0" Padding="12,8" Click="ApplyMenuTemplate_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="12" BorderBrush="#E8EDF3" BorderThickness="1" Padding="22" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Acesso Super Admin" FontSize="17" FontWeight="Bold"/>
                                <TextBlock x:Name="AdminSessionStatus" Text="Acesso administrativo bloqueado." Foreground="#748198" Margin="0,6,0,10"/>
                                <Button x:Name="AdminSessionButton" Content="Entrar como Super Admin" HorizontalAlignment="Left" Padding="14,9" Background="#17233B" Foreground="White" Click="AdminSession_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="12" BorderBrush="#F0D2CF" BorderThickness="1" Padding="22" Margin="0,14,0,8">
                            <StackPanel>
                                <TextBlock Text="Conta da loja" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="Encerra a sessão lembrada neste computador. Os dados locais serão mantidos." TextWrapping="Wrap" Foreground="#748198" Margin="0,6,0,10"/>
                                <Button Content="Sair da conta" HorizontalAlignment="Left" Padding="14,9" Background="#B42318" Foreground="White" Click="Logout_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
            <TextBlock x:Name="FooterStatus" Grid.Row="2" Text="Pronto" Foreground="#748198" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
