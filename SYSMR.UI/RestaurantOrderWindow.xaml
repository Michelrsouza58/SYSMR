<Window x:Class="SYSMR.UI.RestaurantOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/SYSMR.UI;component/Assets/sysmr.ico"
        Title="Comanda" Width="940" Height="640" MinWidth="800" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Comanda" FontSize="24" FontWeight="Bold" Foreground="#17233B"/>
                <TextBlock x:Name="StatusText" Text="Carregando comanda..." Foreground="#68778F" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Atendente" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="EmployeeCombo" Width="190" Padding="7" DisplayMemberPath="Name"/>
            </StackPanel>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,16,0,12">
            <TextBlock Text="Consumo da mesa" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Imprimir cozinha" Padding="10,8" Margin="0,0,8,0" Click="PrintKitchen_Click"/>
                <ComboBox x:Name="MenuItemCombo" Width="280" Padding="8" DisplayMemberPath="Name"/>
                <TextBox x:Name="QuantityBox" Text="1" Width="65" Padding="8" Margin="8,0"/>
                <Button Content="＋ Adicionar" Background="#17233B" Foreground="White" Click="AddItem_Click"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E8EDF3" BorderThickness="1" Padding="0">
            <DataGrid x:Name="ItemsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ITEM" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="QUANTIDADE" Binding="{Binding Quantity, StringFormat=N2}" Width="140"/>
                    <DataGridTextColumn Header="UNITÁRIO" Binding="{Binding UnitPrice, StringFormat=C2}" Width="140"/>
                    <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=C2}" Width="140"/>
                    <DataGridTemplateColumn Header="AÇÃO" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}" ToolTip="Remover item da comanda"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Width="34" Height="30" Padding="0"
                                        Background="#FDECEC" BorderBrush="#F2C4C1" BorderThickness="1"
                                        Click="RemoveOrderItem_Click">
                                    <Grid Width="18" Height="18">
                                        <Rectangle Width="16" Height="2" Fill="#B42318" RadiusX="1" RadiusY="1"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                        <Rectangle Width="7" Height="2" Fill="#B42318" RadiusX="1" RadiusY="1"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0"/>
                                        <Border Width="11" Height="10" BorderBrush="#B42318" BorderThickness="1.5"
                                                CornerRadius="1,1,3,3" HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                        <Rectangle Width="1.5" Height="6" Fill="#B42318" RadiusX="0.7" RadiusY="0.7"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,3,3"/>
                                        <Rectangle Width="1.5" Height="6" Fill="#B42318" RadiusX="0.7" RadiusY="0.7"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="3,0,0,3"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <CheckBox x:Name="WaiterServiceChargeCheckBox" Content="Incluir 10% do garçom" Margin="0,0,0,5" Click="WaiterServiceCharge_Click"/>
                <TextBlock x:Name="ServiceChargeText" Text="10% do garçom: R$ 0,00" FontSize="11" Foreground="#748198"/>
                <TextBlock x:Name="TotalText" Text="Consumo: R$ 0,00" FontSize="16" FontWeight="Bold" Foreground="#17233B" Margin="0,3,0,0"/>
                <TextBlock x:Name="BalanceText" Text="Saldo: R$ 0,00" FontSize="22" FontWeight="Bold" Foreground="#18A999"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,7">
                    <TextBlock Text="Valor" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="PaymentAmountBox" Width="108" Padding="8" VerticalContentAlignment="Center"/>
                    <ComboBox x:Name="PaymentCombo" Width="164" Padding="8" Margin="6,0,0,0" SelectedIndex="0">
                        <ComboBoxItem Content="Dinheiro"/>
                        <ComboBoxItem Content="Pix"/>
                        <ComboBoxItem Content="Cartão de débito"/>
                        <ComboBoxItem Content="Cartão de crédito"/>
                    </ComboBox>
                    <Button Content="Registrar pagamento" Background="#18A999" Foreground="White" Padding="12,9" Margin="6,0,0,0" Click="Pay_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Usar saldo total" Padding="10,7" Click="UseFullBalance_Click"/>
                    <TextBlock Text="Dividir em" VerticalAlignment="Center" Margin="12,0,5,0"/>
                    <TextBox x:Name="SplitPeopleBox" Text="2" Width="48" Padding="7" VerticalContentAlignment="Center"/>
                    <TextBlock Text="pessoas" VerticalAlignment="Center" Margin="5,0,6,0"/>
                    <Button Content="Calcular parcela" Padding="10,7" Click="SplitBalance_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
