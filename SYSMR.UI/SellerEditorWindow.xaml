<Window x:Class="SYSMR.UI.SellerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro de vendedor" Width="420" Height="240" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Text="Novo vendedor" FontSize="22" FontWeight="Bold" Foreground="#17233B"/>
        <StackPanel Grid.Row="1" Margin="0,18,0,12">
            <TextBlock Text="Nome do vendedor" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="NameBox" Padding="9" MaxLength="100" KeyDown="NameBox_KeyDown"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Margin="0,0,8,0" Padding="12,7" Click="Cancel_Click"/>
            <Button Content="Salvar" Background="#17233B" Foreground="White" Padding="14,7" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
