<Window x:Class="SYSMR.UI.AccountPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receber nota" Width="440" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Recebimento da nota" FontSize="24" FontWeight="Bold" Foreground="#17233B"/>
        <StackPanel Grid.Row="1" Margin="0,14,0,16">
            <TextBlock x:Name="AccountCustomerText" Foreground="#748198"/>
            <TextBlock x:Name="AccountBalanceText" FontSize="25" FontWeight="Bold" Foreground="#18A999" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2">
            <TextBlock Text="Valor recebido (pode ser parcial)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="AmountBox" Padding="10" FontSize="18" Margin="0,0,0,14"/>
            <TextBlock Text="Forma de recebimento" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox x:Name="PaymentCombo" Padding="10" SelectedIndex="0">
                <ComboBoxItem Content="Dinheiro"/>
                <ComboBoxItem Content="Pix"/>
                <ComboBoxItem Content="Cartão de débito"/>
                <ComboBoxItem Content="Cartão de crédito"/>
            </ComboBox>
            <TextBlock Text="O recebimento será registrado no caixa e na sincronização pendente."
                       TextWrapping="Wrap" Foreground="#748198" FontSize="12" Margin="0,14,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Voltar" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Registrar recebimento" Background="#17233B" Foreground="White" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
