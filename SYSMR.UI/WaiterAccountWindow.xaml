<Window x:Class="SYSMR.UI.WaiterAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acesso do garçom" Width="500" Height="680" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Cadastro de garçom" FontSize="22" FontWeight="Bold" Foreground="#17233B"/>
            <TextBlock Text="A senha será usada somente no Firebase Authentication e não será guardada no computador."
                       Foreground="#62718A" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,14">
            <StackPanel>
                <TextBlock Text="Nome" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="NameBox" Padding="9" Margin="0,0,0,12"/>
                <TextBlock Text="Função" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="RoleBox" Padding="9" Margin="0,0,0,12"/>
                <TextBlock Text="Número do garçom (login)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="NumberBox" Padding="9" Margin="0,0,0,12"/>
                <StackPanel x:Name="PasswordPanel">
                    <TextBlock Text="Senha inicial (mínimo 8 caracteres)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBox" Padding="9" Margin="0,0,0,12"/>
                    <TextBlock Text="Confirmar senha inicial" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Padding="9" Margin="0,0,0,12"/>
                </StackPanel>
                <TextBlock Text="Áreas permitidas no webapp" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock Text="Selecione onde este garçom poderá consultar mesas e enviar pedidos."
                           Foreground="#62718A" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel x:Name="AreasPanel"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Margin="0,0,8,0" Padding="12,7" Click="Cancel_Click"/>
            <Button Content="Salvar acesso" Background="#17233B" Foreground="White" Padding="14,7" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
