<Window x:Class="SYSMR.UI.ReceiptFormatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Formato de impressão" Width="420" Height="300" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Como deseja imprimir?" FontSize="23" FontWeight="Bold" Foreground="#17233B"/>
            <TextBlock Text="Escolha o formato para este comprovante." Foreground="#748198" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,18,0,14">
            <RadioButton x:Name="ThermalOption" Content="Cupom térmico — 80 mm"
                         FontSize="15" Padding="8" Margin="0,0,0,8"/>
            <RadioButton x:Name="A4Option" Content="Folha A4 — com espaço para assinatura"
                         FontSize="15" Padding="8"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Margin="0,0,8,0" Padding="12,7" Click="Cancel_Click"/>
            <Button Content="Continuar" Background="#17233B" Foreground="White"
                    Padding="14,7" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
